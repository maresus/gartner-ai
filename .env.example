# OpenAI API
OPENAI_API_KEY=sk-...

# Model selection
OPENAI_MODEL=gpt-5.2

# Admin Security
ADMIN_TOKEN=your-secret-token-here

# Email Configuration (REQUIRED for sending reservation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@kovacnik.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=info@kovacnik.com
SMTP_FROM_NAME=Domačija Kovačnik
SMTP_SSL=false

# Admin Notifications
ADMIN_EMAIL=info@kovacnik.com
CC_ADMIN_EMAIL=satlermarko@gmail.com

# Base URL (for email links)
BASE_URL=https://kovacnik-ai-production.up.railway.app

# Optional: Resend.com alternative to SMTP
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
